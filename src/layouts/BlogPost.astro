<script>
	const scrollBtn = document.getElementById("to-top-btn") as HTMLButtonElement | null;
	const heroEl = document.getElementById("blog-hero") as HTMLDivElement | null;
	if (scrollBtn && heroEl) {
		new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				scrollBtn.dataset.show = (!entry.isIntersecting).toString();
			});
		}).observe(heroEl);
		scrollBtn.addEventListener("click", () =>
			document.documentElement.scrollTo({ behavior: "smooth", top: 0 }),
		);
	}

	const progressBar = document.getElementById("reading-progress") as HTMLElement | null;
	if (progressBar) {
		const update = () => {
			const h = document.documentElement;
			const max = h.scrollHeight - h.clientHeight;
			const pct = max > 0 ? Math.min(100, (h.scrollTop / max) * 100) : 0;
			progressBar.style.width = pct + "%";
		};
		update();
		window.addEventListener("scroll", update, { passive: true });
		window.addEventListener("resize", update, { passive: true });
	}

	const lazyImgs = document.querySelectorAll<HTMLImageElement>(
		'.post-article img[loading="lazy"]',
	);
	if (lazyImgs.length && "IntersectionObserver" in window) {
		const io = new IntersectionObserver(
			(entries) => {
				entries.forEach((e) => {
					if (e.isIntersecting) {
						(e.target as HTMLElement).dataset.in = "1";
						io.unobserve(e.target);
					}
				});
			},
			{ rootMargin: "120px 0px" },
		);
		lazyImgs.forEach((img) => io.observe(img));
	}

  function initArticleHeadings() {
    const article = document.querySelector<HTMLElement>(".post-article");
    if (!article) return;

    const slugify = (s: string) =>
      s.toLowerCase().trim().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
    const usedIds = new Set<string>();

    // 1. Wrap sections for h3, then h2, then h1 (from innermost to outermost)
    const levels = ["h3", "h2", "h1"];
    levels.forEach((tag) => {
      const headings = Array.from(article.querySelectorAll<HTMLHeadingElement>(tag));
      headings.forEach((h) => {
        const levelNum = parseInt(h.tagName[1], 10);

        // Ensure unique ID for anchoring
        const baseId = h.id || slugify(h.textContent ?? "");
        if (baseId) {
          let id = baseId;
          for (let n = 2; usedIds.has(id); n++) id = `${baseId}-${n}`;
          usedIds.add(id);
          if (!h.id) h.id = id;
        }

        // Find sibling elements belonging to this section
        const siblings: Element[] = [];
        let next = h.nextElementSibling;
        while (next) {
          if (/^H[1-6]$/i.test(next.tagName)) {
            const nextLevel = parseInt(next.tagName[1], 10);
            if (nextLevel <= levelNum) break;
          }
          siblings.push(next);
          next = next.nextElementSibling;
        }

        if (siblings.length === 0) return;

        // Create collapsible wrapper
        const wrapper = document.createElement("div");
        wrapper.className = "heading-content";
        wrapper.setAttribute("data-collapsed", "false");

        const inner = document.createElement("div");
        inner.className = "heading-content-inner";

        siblings.forEach((el) => inner.appendChild(el));
        wrapper.appendChild(inner);
        h.insertAdjacentElement("afterend", wrapper);

        // Create collapse chevron button (replacing the '#')
        const collapseBtn = document.createElement("button");
        collapseBtn.type = "button";
        collapseBtn.className = "heading-collapse-btn";
        collapseBtn.setAttribute("aria-label", `Toggle ${h.textContent ?? "section"}`);
        collapseBtn.setAttribute("aria-expanded", "true");
        collapseBtn.innerHTML = `
          <svg class="chevron-icon" viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 6l4 4 4-4"/>
          </svg>
        `;

        collapseBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          const isCollapsed = wrapper.getAttribute("data-collapsed") === "true";
          wrapper.setAttribute("data-collapsed", isCollapsed ? "false" : "true");
          collapseBtn.setAttribute("aria-expanded", isCollapsed ? "true" : "false");
        });

        h.prepend(collapseBtn);
      });
    });

    // 2. Make headings clickable to anchor & copy permalink
    const allHeadings = article.querySelectorAll<HTMLHeadingElement>(
      "h1, h2, h3, h4, h5, h6"
    );
    allHeadings.forEach((h) => {
      if (!h.id) {
        const baseId = slugify(h.textContent ?? "");
        if (baseId) {
          let id = baseId;
          for (let n = 2; usedIds.has(id); n++) id = `${baseId}-${n}`;
          usedIds.add(id);
          h.id = id;
        }
      }

      const id = h.id;
      if (!id) return;

      h.classList.add("heading-clickable");
      h.setAttribute("title", "Click to copy link");

      // Feedback symbol (silent copy indicator)
      const pill = document.createElement("span");
      pill.className = "heading-copy-pill";
      pill.setAttribute("aria-hidden", "true");
      pill.innerHTML = `
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
        </svg>
      `;
      h.appendChild(pill);

      let copyTimeout: number | undefined;
      h.addEventListener("click", async (e) => {
        // Don't trigger if clicked on the chevron button
        if ((e.target as HTMLElement).closest(".heading-collapse-btn")) return;
        // Don't trigger if user is selecting text
        if (window.getSelection()?.toString()) return;

        const url = `${location.origin}${location.pathname}#${id}`;
        history.replaceState(null, "", `#${id}`);

        // If this heading's section is collapsed, expand it
        const ownWrapper = h.nextElementSibling;
        if (ownWrapper && ownWrapper.classList.contains("heading-content")) {
          if (ownWrapper.getAttribute("data-collapsed") === "true") {
            ownWrapper.setAttribute("data-collapsed", "false");
            const btn = h.querySelector<HTMLButtonElement>(".heading-collapse-btn");
            if (btn) btn.setAttribute("aria-expanded", "true");
          }
        }

        try {
          await navigator.clipboard.writeText(url);
          if (copyTimeout) clearTimeout(copyTimeout);
          pill.setAttribute("data-show", "true");
          copyTimeout = window.setTimeout(() => {
            pill.removeAttribute("data-show");
          }, 1400);
        } catch {}
      });
    });

    // 3. Auto-expand section if hash matches target or child
    function expandTargetFromHash() {
      const hash = window.location.hash.slice(1);
      if (!hash) return;
      const target = document.getElementById(hash);
      if (!target) return;

      // Expand target's own section if it's a heading with a collapsible wrapper
      const ownWrapper = target.nextElementSibling;
      if (ownWrapper && ownWrapper.classList.contains("heading-content")) {
        ownWrapper.setAttribute("data-collapsed", "false");
        const ownBtn = target.querySelector<HTMLButtonElement>(".heading-collapse-btn");
        if (ownBtn) ownBtn.setAttribute("aria-expanded", "true");
      }

      // Expand all ancestor collapsible sections containing target
      let parent = target.parentElement;
      while (parent && parent !== article) {
        if (parent.classList.contains("heading-content")) {
          parent.setAttribute("data-collapsed", "false");
          const prevHeading = parent.previousElementSibling;
          const btn = prevHeading?.querySelector<HTMLButtonElement>(".heading-collapse-btn");
          if (btn) btn.setAttribute("aria-expanded", "true");
        }
        parent = parent.parentElement;
      }

      // Ensure smooth scroll to target after DOM settles
      setTimeout(() => {
        target.scrollIntoView({ behavior: "smooth", block: "start" });
      }, 50);
    }

    expandTargetFromHash();
    window.addEventListener("hashchange", expandTargetFromHash);
  }

  function initCodeCopyButtons() {
    document.querySelectorAll<HTMLButtonElement>(".expressive-code .copy button").forEach((btn) => {
      if (btn.dataset.tickBound) return;
      btn.dataset.tickBound = "true";
      btn.addEventListener("click", () => {
        btn.setAttribute("data-is-copied", "true");
        setTimeout(() => {
          btn.removeAttribute("data-is-copied");
        }, 1500);
      });
    });
  }

  initArticleHeadings();
  initCodeCopyButtons();
  document.addEventListener("astro:after-swap", () => {
    initArticleHeadings();
    initCodeCopyButtons();
  });
</script>
