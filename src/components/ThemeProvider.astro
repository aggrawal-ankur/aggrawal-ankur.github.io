{/* Inlined to avoid FOUC — this is a parser-blocking script. */}
<script is:inline>
  (() => {
    try {
      const valid = ["eink", "glacier", "sage", "twilight", "steel", "light"];
      const s = localStorage.getItem("theme") || localStorage.getItem("reading_palette");
      document.documentElement.dataset.theme = s && valid.includes(s) ? s : "eink";
    } catch {}
  })();

  addEventListener("DOMContentLoaded", () => {
    requestAnimationFrame(() => document.documentElement.classList.add("theme-ready"));
  });

  const validThemes = ["eink", "glacier", "sage", "twilight", "steel", "light"];

  function setTheme(newTheme) {
    if (!validThemes.includes(newTheme)) return;
    const root = document.documentElement;
    if (newTheme === root.getAttribute("data-theme")) return;
    root.setAttribute("data-theme", newTheme);
    const meta = document.querySelector("meta[name='theme-color']");
    if (meta && document.body) {
      const bg = getComputedStyle(document.body).getPropertyValue("--theme-bg");
      meta.setAttribute("content", `hsl(${bg})`);
    }
    try {
      localStorage.setItem("theme", newTheme);
      localStorage.setItem("reading_palette", newTheme);
    } catch {}
  }

  document.addEventListener("theme-change", (e) => setTheme(e.detail.theme));
</script>
