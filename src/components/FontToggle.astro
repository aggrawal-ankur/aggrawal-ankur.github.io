<div class="font-menu-wrap">
  <button
    type="button"
    id="font-toggle-btn"
    class="font-icon-btn"
    aria-label="Reading typography"
    aria-expanded="false"
    title="Switch typography"
  >
    <span>Aa</span>
  </button>
  <div id="font-tray" class="font-tray" data-open="false">
    <div class="tray-section-title">TYPOGRAPHY</div>
    <button type="button" class="font-opt" data-font="inter">
      <span class="font-name" style="font-family: 'Inter Variable', sans-serif;">Default (Inter)</span>
      <span class="font-desc">Screen Engineered &middot; Tall Cap</span>
    </button>
    <button type="button" class="font-opt" data-font="atkinson">
      <span class="font-name" style="font-family: 'Atkinson Hyperlegible', sans-serif;">Atkinson Hyperlegible</span>
      <span class="font-desc">Low Strain &middot; Optical Clarity</span>
    </button>
  </div>
</div>

<style is:global>
  .font-menu-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .font-icon-btn {
    background: var(--paper);
    border: 1px solid var(--hairline);
    color: hsl(var(--theme-text-muted));
    width: 32px;
    height: 32px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: -0.02em;
    transition: color 0.18s ease, border-color 0.18s ease, background-color 0.18s ease;
  }

  .font-icon-btn:hover,
  .font-icon-btn[aria-expanded="true"] {
    color: hsl(var(--theme-accent));
    border-color: hsl(var(--theme-accent));
  }

  .font-icon-btn:focus-visible {
    outline: 2px solid hsl(var(--theme-accent));
    outline-offset: 3px;
  }

  .font-tray {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    background: var(--paper);
    border: 1px solid var(--hairline);
    border-radius: 8px;
    padding: 6px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 220px;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.5);
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-6px) scale(0.96);
    transform-origin: top right;
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0.2s;
  }

  .font-tray[data-open="true"] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0) scale(1);
  }

  .tray-section-title {
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: hsl(var(--theme-text-muted));
    padding: 4px 8px 3px;
    opacity: 0.75;
  }

  .font-opt {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 7px 9px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    cursor: pointer;
    text-align: left;
    width: 100%;
    color: hsl(var(--theme-text));
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .font-opt:hover {
    background: rgba(255, 255, 255, 0.05);
  }

  .font-opt[aria-selected="true"] {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.12);
  }

  .font-opt[aria-selected="true"] .font-name {
    color: hsl(var(--theme-accent));
    font-weight: 600;
  }

  .font-name {
    font-size: 13.5px;
    line-height: 1.3;
  }

  .font-desc {
    font-family: var(--font-mono);
    font-size: 9.5px;
    color: hsl(var(--theme-text-muted));
    margin-top: 2px;
  }
</style>

<script>
  function initFontToggle() {
    const btn = document.getElementById("font-toggle-btn");
    const tray = document.getElementById("font-tray");
    if (!btn || !tray) return;

    const fontFamilies: Record<string, string> = {
      inter: '"Inter Variable", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif',
      atkinson: '"Atkinson Hyperlegible", -apple-system, BlinkMacSystemFont, sans-serif',
    };

    function applyFont(key: string) {
      const family = fontFamilies[key] || fontFamilies.inter;
      const root = document.documentElement;
      root.style.setProperty("--font-sans", family);
      root.style.setProperty("--font-heading", family);
      root.style.setProperty("--font-serif", family);
      root.dataset.font = key;
      try {
        localStorage.setItem("reading_font", key);
      } catch {}
      document.querySelectorAll(".font-opt").forEach((opt) => {
        opt.setAttribute("aria-selected", opt.getAttribute("data-font") === key ? "true" : "false");
      });
    }

    const currentFont = localStorage.getItem("reading_font") || "inter";
    applyFont(currentFont);

    function toggleTray() {
      const isOpen = tray?.getAttribute("data-open") === "true";
      const next = !isOpen;
      tray?.setAttribute("data-open", next ? "true" : "false");
      btn?.setAttribute("aria-expanded", next ? "true" : "false");
    }

    function closeTray() {
      tray?.setAttribute("data-open", "false");
      btn?.setAttribute("aria-expanded", "false");
    }

    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      const paletteTray = document.getElementById("palette-tray");
      const paletteBtn = document.getElementById("palette-toggle-btn");
      if (paletteTray) paletteTray.setAttribute("data-open", "false");
      if (paletteBtn) paletteBtn.setAttribute("aria-expanded", "false");
      toggleTray();
    });

    document.querySelectorAll(".font-opt").forEach((opt) => {
      opt.addEventListener("click", (e) => {
        e.stopPropagation();
        const font = opt.getAttribute("data-font");
        if (font) applyFont(font);
        closeTray();
      });
    });

    document.addEventListener("click", (e) => {
      if (!tray.contains(e.target as Node) && !btn.contains(e.target as Node)) {
        closeTray();
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeTray();
    });
  }

  initFontToggle();
  document.addEventListener("astro:after-swap", initFontToggle);
</script>

