---
import { getEntry, render } from "astro:content";
import PageLayout from "@/layouts/Base.astro";
import { siteConfig } from "@/site-config";
import { absoluteUrl } from "@/utils/path";
import { Schema } from "astro-seo-schema";

const entry = await getEntry("page", "about");
if (!entry) throw new Error("Missing src/content/page/about.md");
const { Content } = await render(entry);

const profile = siteConfig.profile;
const authorName = profile?.name ?? siteConfig.author;

const meta = {
	description: entry.data.description ?? `${authorName} — about me.`,
	title: entry.data.title,
};

const personSameAs = [
	profile?.linkedin,
	profile?.github,
	profile?.twitter,
	profile?.mastodon,
].filter((s): s is string => Boolean(s));

const avatarUrl = profile?.avatar ? absoluteUrl(profile.avatar, Astro.site) : undefined;
interface SocialLink {
	href: string;
	label: string;
	rel?: string;
	target?: string;
}

const socialLinks: SocialLink[] = [];
if (profile?.github) {
	socialLinks.push({ href: profile.github, label: "GitHub", rel: "noreferrer", target: "_blank" });
}
if (profile?.linkedin) {
	socialLinks.push({ href: profile.linkedin, label: "LinkedIn", rel: "noreferrer", target: "_blank" });
}
if (profile?.email) {
	socialLinks.push({ href: `mailto:${profile.email}`, label: "Email" });
}
---

<Schema
	item={{
		"@context": "https://schema.org",
		"@type": "ProfilePage",
		mainEntity: {
			"@type": "Person",
			name: authorName,
			...(avatarUrl ? { image: avatarUrl } : {}),
			...(profile?.jobTitle ? { jobTitle: profile.jobTitle } : {}),
			...(profile?.employer
				? {
						worksFor: {
							"@type": "Organization",
							name: profile.employer,
							...(profile.employerUrl ? { url: profile.employerUrl } : {}),
						},
					}
				: {}),
			...(profile?.alumni
				? {
						alumniOf: {
							"@type": "CollegeOrUniversity",
							name: profile.alumni,
						},
					}
				: {}),
			...(personSameAs.length ? { sameAs: personSameAs } : {}),
		},
	}}
/>

<PageLayout meta={meta}>
	<section class="about" aria-labelledby="about-label">
		{
			profile?.avatar && (
				<div class="profile-card">
					<div class="avatar-wrap">
						<img
							src={profile.avatar}
							alt={authorName}
							class="author-avatar"
							width="96"
							height="96"
							loading="eager"
						/>
					</div>
					<div class="profile-details">
						<h1 class="profile-name">{authorName}</h1>
						{socialLinks.length > 0 && (
							<div class="profile-socials">
								{socialLinks.map((item, index) => (
									<>
										<a href={item.href} target={item.target} rel={item.rel}>
											{item.label}
										</a>
										{index < socialLinks.length - 1 && <span class="sep">·</span>}
									</>
								))}
							</div>
						)}
					</div>
				</div>
			)
		}
		<div class="section-label" id="about-label">About</div>
		<div class="bio">
			<Content />
		</div>
	</section>
</PageLayout>

<style>
	.about {
		margin-bottom: 64px;
	}
	.profile-card {
		display: flex;
		align-items: center;
		gap: 28px;
		max-width: var(--reading-width);
		padding: 24px 28px;
		margin-bottom: 36px;
		background: var(--paper);
		border: 1px solid var(--hairline);
		border-left: 3px solid hsl(var(--theme-accent));
		border-radius: 6px;
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
		transition: background-color 0.35s ease, border-color 0.35s ease;
	}
	.avatar-wrap {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.author-avatar {
		width: 96px;
		height: 96px;
		border-radius: 50%;
		object-fit: cover;
		padding: 3px;
		border: 2px solid hsl(var(--theme-accent) / 0.5);
		background-color: hsl(var(--theme-bg));
		box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08), 0 0 0 1px var(--hairline);
		transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
	}
	.author-avatar:hover {
		border-color: hsl(var(--theme-accent));
		transform: scale(1.04);
		box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12), 0 0 0 1px hsl(var(--theme-accent));
	}
	.profile-details {
		display: flex;
		flex-direction: column;
		gap: 8px;
		min-width: 0;
	}
	.profile-name {
		font-family: var(--font-serif);
		font-size: 23px;
		font-weight: 600;
		line-height: 1.25;
		color: hsl(var(--theme-text));
		letter-spacing: normal;
		word-spacing: 0.02em;
		margin: 0;
	}
	.profile-socials {
		font-family: var(--font-sans);
		font-size: 13.5px;
		color: hsl(var(--theme-text) / 0.72);
	}
	.profile-socials a {
		color: hsl(var(--theme-text-muted));
		text-decoration: underline;
		text-decoration-color: hsl(var(--theme-text) / 0.35);
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
		transition: color 0.2s ease, text-decoration-color 0.2s ease;
	}
	.profile-socials a:hover {
		color: hsl(var(--theme-accent));
		text-decoration-color: hsl(var(--theme-accent));
	}
	.profile-socials .sep {
		color: var(--faint);
		margin: 0 8px;
	}
	.bio {
		font-family: var(--font-serif);
		font-size: 17.5px;
		line-height: 1.75;
		word-spacing: 0.04em;
		color: hsl(var(--theme-text));
		max-width: var(--reading-width);
	}
	.bio :global(ul) {
		list-style: disc;
		list-style-position: inside;
		margin: 0 0 28px;
		padding: 0;
	}
	.bio :global(ul li) {
		margin-bottom: 6px;
		text-wrap: pretty;
		word-wrap: break-word;
		overflow-wrap: anywhere;
	}
	.bio :global(ul li:last-child) {
		margin-bottom: 0;
	}
	.bio :global(p) {
		margin: 0 0 22px;
		text-wrap: pretty;
	}
	.bio :global(p:last-child) {
		margin-bottom: 0;
	}
	.bio :global(a) {
		color: hsl(var(--theme-text));
		text-decoration: underline;
		text-decoration-color: hsl(var(--theme-text) / 0.35);
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
		transition: color 0.2s ease, text-decoration-color 0.2s ease;
	}
	.bio :global(a:hover) {
		color: hsl(var(--theme-accent));
		text-decoration-color: hsl(var(--theme-accent));
	}
	.bio :global(a:focus-visible) {
		outline: 2px solid hsl(var(--theme-accent));
		outline-offset: 3px;
		border-radius: 3px;
	}

	@media (max-width: 720px) {
		.bio {
			font-size: 17px;
			line-height: 1.7;
		}
	}
	@media (max-width: 420px) {
		.author-avatar {
			width: 80px;
			height: 80px;
		}
		.avatar-wrap {
			margin-bottom: 22px;
		}
		.bio {
			font-size: 16.5px;
		}
	}
</style>
